# =====================================================================
# OpenSSL 3.5+ native PQC TLS demo.
#
# OpenSSL 3.5.0 (released 2025-04-08) ships ML-KEM-{512,768,1024}, ML-DSA and
# SLH-DSA in its default provider, so this lane needs no plugin. It is the
# standardised-algorithm lane, not a certified one: it runs Debian's default
# provider, not a FIPS 140-3 validated module in FIPS mode, and nothing in this
# repository is fit for production (docs/LIMITATIONS.md). An earlier header
# called it "FIPS-stable" and "recommended for production"; neither held.
# The oqs-provider lane (Dockerfile.oqs-provider) runs on the same OpenSSL and
# adds non-standard KEM groups through the provider mechanism.
#
# Usage:
#   make pqc-tls-demo-both
#
# That line used to read `PQC_PROVIDER=native make pqc-tls-demo-both`. No such
# switch exists: `pqc-tls-demo-both` builds both the native and the
# oqs-provider image unconditionally and reads no such variable. The rest of
# the tree withdrew the `PQC_PROVIDER` claim; this was the last place still
# presenting it as something an operator could set.
#
# Inside the container:
#   openssl s_server -tls1_3 -groups X25519MLKEM768 -accept 4433
#   openssl s_client -tls1_3 -groups X25519MLKEM768 -connect tls35:4433
# =====================================================================
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssl ca-certificates curl iproute2 jq && \
    rm -rf /var/lib/apt/lists/*

# Verify the OpenSSL we got is ≥ 3.5 (Debian trixie ships 3.5.x)
RUN openssl version | grep -E "OpenSSL [3-9]\.[5-9]" || \
    (echo "ERROR: OpenSSL >= 3.5 required for native PQC" >&2; exit 1)

# Generate a self-signed cert for the demo
RUN openssl req -x509 -newkey rsa:2048 -keyout /etc/ssl/private/server.key \
        -out /etc/ssl/certs/server.crt -days 365 -nodes \
        -subj "/CN=tls35.pqcqkd.local" -batch

EXPOSE 4433

# The three PQ/T hybrid groups of RFC 10024 (August 2026), which this line
# previously cited as the individual draft draft-kwiatkowski-tls-ecdhe-mlkem-02.
ENV TLS_GROUPS="X25519MLKEM768:SecP256r1MLKEM768:SecP384r1MLKEM1024"

CMD ["sh", "-c", "openssl s_server -tls1_3 -groups ${TLS_GROUPS} \
                                   -accept 0.0.0.0:4433 \
                                   -cert /etc/ssl/certs/server.crt \
                                   -key /etc/ssl/private/server.key \
                                   -www"]
