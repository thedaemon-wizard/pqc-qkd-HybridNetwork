# ============================================================
# Cloud deployment environment (KVM VPS + a DNS provider of your choice).
# Copy to `.env` at the repo root before running deploy/deploy.sh:
#     cp deploy/.env.example .env
# Never commit the filled-in `.env`.
# ============================================================

# ----- Public entry point (Caddy auto-TLS) -----
# Your domain, with an A record pointed at the VPS public IP.
PUBLIC_HOST=qkd.example.com
# Contact e-mail for Let's Encrypt.
ACME_EMAIL=admin@example.com

# Keep the WebUI bound to loopback on the host — only Caddy is public.
# (Caddy reaches these over the internal docker network by service name.)
WEBUI_FRONTEND_PORT=127.0.0.1:5173
WEBUI_BACKEND_PORT=127.0.0.1:8000

# MUST stay false on a public host. When true, any visitor to /physics can
# switch the simulator backend, enable Eve or move the QBER abort threshold on
# the live KMEs that feed both VPN lanes, and every other visitor sees the
# change. False makes those three POST routes answer 403 and leaves /physics
# computing in the browser. scripts/verify-demo-hardening.sh checks it.
#
# This is the only backend switch this file can set. DEMO_MODE,
# ENABLE_CONTAINER_CONTROL, the rate limit and the export-store bounds are not
# forwarded from .env: they keep the backend's defaults unless an overlay sets
# them, as docker-compose.demo.yml does for DEMO_MODE, so container control
# stays off here (docs/BUILD.md section 7.1).
ENABLE_LIVE_PARAM_OVERRIDES=false

# ----- BB84 physics backend (license-aware) -----
# Distributable / client-delivery profile defaults to the fully-permissive
# Strawberry Fields backend (Apache-2.0). For SaaS you may opt into others:
#   qutip (BSD-3) | simqn (GPL-3.0) | sequence (custom Argonne, BSD-3-equiv)
#   | cvqkd (Strawberry Fields, Apache-2.0)
# NOT composite or qkdnetsim_proxy here: both pull keys from the qkdnetsim-kme
# container, which exists only under docker-compose.qkdnetsim.yml (profile
# crossvalidate). deploy.sh does not start that overlay, so on this host every
# round of either backend fails and the key pools stop refilling.
SIMULATOR_BACKEND=cvqkd

# ----- Arnika (QKD‖PQC hybrid) -----
# The PQC half is arnika's own PQC-HPKE key agreement with its peer. Its
# switch, PQC_ENABLED, is set to "true" on every node by the compose files and
# is not offered here. ARNIKA_MODE is one variable read by every node, so both
# peers of a pair always run the same mode, which arnika requires.
ARNIKA_MODE=QkdAndPqcRequired
ARNIKA_INTERVAL=30s

# MANDATORY. docker-compose.yml declares this as ${ARNIKA_PSK:?...} for both the
# alice and bob nodes, and Compose interpolates the whole file even for an `up`
# that names only the web services -- so without it nothing starts, including a
# demo-only deployment that never runs those nodes.
#
# The `env-example` CI job (scripts/check_env_example.sh) fails if a mandatory
# variable goes missing from this file.
#
# It must be IDENTICAL on both peers: arnika's master election is
# HMAC(ARNIKA_PSK, interval) XOR ARNIKA_ID, and the same secret authenticates
# every arnika packet between the two nodes (key_ID and PQC-HPKE frames).
#
# At least 32 bytes. The node entrypoints refuse the placeholder below, which
# is long enough to pass arnika's own length check, so replace it before the
# first `up` of a node.
#
#   openssl rand -base64 32
ARNIKA_PSK=replace-me-run-openssl-rand-base64-32

# ----- Rosenpass (real post-quantum exchange; keys the wg1 data tunnel) -----
# Rosenpass binds each node's wg0 address on this UDP port, so its exchange
# runs inside the wg0 hop tunnel. Never published on the host.
RP_LISTEN_PORT=9997

# ----- BB84-KME tuning -----
# None here. The physics tunables live in config/qkd_params.yaml, which the KME
# hot-reloads and which tests/test_every_config_key_is_read_by_something.py
# guards. tests/test_compose_env_is_read_by_something.py fails if a variable in
# this file is read by nothing.

# ----- WireGuard internal addressing (not published publicly) -----
# wg0, the hop tunnel keyed by arnika.
WG_ALICE_IP=10.0.0.1
WG_BOB_IP=10.0.0.2
WG_LISTEN_PORT_ALICE=51820
WG_LISTEN_PORT_BOB=51821
# wg1, the end-to-end data tunnel keyed by Rosenpass, carried inside wg0.
WG1_ALICE_IP=10.0.1.1
WG1_BOB_IP=10.0.1.2
WG1_LISTEN_PORT_ALICE=51830
WG1_LISTEN_PORT_BOB=51831
