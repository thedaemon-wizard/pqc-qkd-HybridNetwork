# ============================================================
# Caddy reverse proxy for the PQC-QKD hybrid WebUI.
#
# - Terminates auto-TLS (Let's Encrypt) for the public hostname.
# - Proxies everything to the webui-frontend container (nginx), which
#   already forwards /api and /ws to webui-backend (WebSocket upgrade
#   is handled transparently by Caddy + the frontend nginx).
#
# Public surface = ONLY this proxy (80/443). KME / backend / WG nodes
# stay on the internal docker networks and are never published.
#
# Env (see deploy/.env.example):
#   PUBLIC_HOST  e.g. qkd.example.com   (real domain → auto HTTPS)
#                use ":80" for a local plain-HTTP smoke test through Caddy
#   ACME_EMAIL   contact address for Let's Encrypt
# ============================================================
{
	email {$ACME_EMAIL:admin@localhost}
}

# Extra sites contributed by the operator of this host, e.g. a second
# project sharing this Caddy. Must come after the global options block,
# which Caddy requires to be first. A glob matching nothing is not an
# error, so this is a no-op on a fresh clone.
import /etc/caddy/conf.d/*.caddy

{$PUBLIC_HOST} {
	encode zstd gzip
	# One header block. Because it deletes a field, Caddy defers all of it
	# until the response is written, so it also covers proxied responses.
	#   -Server: behind this proxy it is the frontend nginx's, and it carried
	#     nginx's exact version to every visitor.
	#   Strict-Transport-Security: browsers that have reached the site over
	#     HTTPS keep using HTTPS for a year (RFC 6797). No includeSubDomains
	#     and no preload: this covers this hostname only, and can be undone by
	#     sending max-age=0. Browsers ignore it over plain HTTP, so the ":80"
	#     smoke test is unaffected.
	#   X-Content-Type-Options: nosniff: the browser does not guess a type; a
	#     script or stylesheet is refused unless its declared type is a
	#     JavaScript or CSS one. Every script here is application/javascript.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy webui-frontend:80
}
