# ============================================================
# PQC-QKD Hybrid PoC — Sample environment file
# Copy to `.env` and adjust as needed. Never commit `.env`.
# ============================================================

# ----- Docker Compose -----
COMPOSE_PROJECT_NAME=pqcqkd

# ----- Arnika (per-node; alice/bob entrypoints read these) -----
# Operational mode. See submodules/arnika/config/config.go:34
# Values: QkdAndPqcRequired | AtLeastQkdRequired | AtLeastPqcRequired | EitherQkdOrPqcRequired
ARNIKA_MODE=QkdAndPqcRequired

# Key rotation interval (default in paper: 120s; use 30s for demo)
ARNIKA_INTERVAL=30s

# Shared secret between the two arnika peers. REQUIRED -- there is no default.
# It keys the AES-256-GCM encryption and HMAC-SHA256 signature applied to the
# UDP key_ID channel (submodules/arnika/auth/auth.go) and the per-interval
# master election (config/config.go, IsPrimary). Must be IDENTICAL on both.
# Generate one with:  openssl rand -base64 32
ARNIKA_PSK=replace-me-run-openssl-rand-base64-32

# Per-node numeric identifier, at most 5 digits. The two values MUST DIFFER:
# arnika XORs this into the master election, so equal IDs make both peers pick
# the same role every interval and the key exchange deadlocks. Left unset,
# arnika derives it from the LISTEN_ADDRESS port -- which is :9999 on both
# nodes here, hence the explicit values.
ARNIKA_ID_ALICE=1
ARNIKA_ID_BOB=2
# Trusted-node relay, only used by the `multihop` profile. Must differ from
# the other two.
ARNIKA_ID_CHARLIE=3

# KMS HTTP timeout / retry
KMS_HTTP_TIMEOUT=10s
KMS_BACKOFF_MAX_RETRIES=5
KMS_BACKOFF_BASE_DELAY=200ms
KMS_RETRY_INTERVAL=10s

# PQC PSK file path (inside container). Rosenpass writes here.
PQC_PSK_FILE=/var/lib/rosenpass/pqc.psk

# ----- BB84-KME -----
# Photon batch size per BB84 round (raises key generation rate; CPU-bound)
# Channel depolarizing probability (0.0 = perfect, 0.02 = realistic fiber)
# Reconciliation QBER abort threshold (Cascade aborts above this)
# Key pool target / max
# Eve attack defaults for the bb84-kme simulator. The WebUI's Eve toggle is a
# client-side engine flag and does not reach these; the removed POST /sim/eve
# proxy did.

# ----- WebUI -----
WEBUI_BACKEND_PORT=8000
WEBUI_FRONTEND_PORT=5173

# ----- WireGuard internal addressing -----
WG_SUBNET=10.0.0.0/24
WG_ALICE_IP=10.0.0.1
WG_BOB_IP=10.0.0.2
WG_CHARLIE_IP=10.0.0.3
WG_LISTEN_PORT_ALICE=51820
WG_LISTEN_PORT_BOB=51821

# ----- mTLS for ETSI-014 (disabled by default; Phase 7) -----
