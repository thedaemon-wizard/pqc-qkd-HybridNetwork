node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# Go (arnika builds inside Docker; just in case)
# ============================================
*.exe
*.test
*.out
# Compiled arnika binary only — anchored, so it cannot swallow
# submodules/arnika or services/arnika-vici/.
/arnika
build/

# ============================================
# Docker / Compose
# ============================================
.env
.env.local
.env.*.local

# ============================================
