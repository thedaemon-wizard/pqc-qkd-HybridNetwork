# ============================================
submodules/liboqs/build/
submodules/oqs-provider/build/
submodules/rosenpass/target/
/opt/oqs/

# ============================================
# Manim renders (large binaries; share via Release)
# ============================================
animations/media/
animations/__pycache__/
docs/images/*.mp4
!docs/images/.gitkeep

# ============================================
# Benchmark results
# ============================================
benchmarks/results/
benchmarks/*.csv
benchmarks/*.png

# ============================================
# Editor / OS
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# SBOM and security scanning outputs
# ============================================
sbom*.json
.gitleaks.report.json

# ============================================
# Private / non-public (do not publish)
# ============================================

*.private.md
*.docx
.~lock.*#

# Local editor / tooling scratch directories are excluded per-checkout via
# .git/info/exclude rather than here, so this published file does not enumerate
# them.

# Round 5 implementation backup (not for publication)
services/webui-frontend/.backup-round5/

# ============================================
# Third-party material we may not redistribute
# ============================================
