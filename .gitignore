# ============================================
# Secrets & Generated Crypto Material
# ============================================
pki/*.pem
pki/*.key
pki/*.crt
pki/*.csr
pki/*.srl
pki/index.txt*
pki/serial*
!pki/.gitkeep
!pki/gen-certs.sh
**/*.psk
**/rosenpass-secret/
**/private.key
**/preshared.key

