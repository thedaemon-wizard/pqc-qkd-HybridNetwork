# Local editor / tooling scratch directories are excluded per-checkout via
# .git/info/exclude rather than here, so this published file does not enumerate
# them.

# Round 5 implementation backup (not for publication)
services/webui-frontend/.backup-round5/

# ============================================
# Third-party material we may not redistribute
# ============================================
# Vendor installer payloads (MathWorks / FlexNet). These were tracked for a
# time; they are proprietary and referenced by nothing in this project.
archives/

# References are redistributable only where the upstream licence allows it.
# Spooren et al. (arXiv:2604.05599) is CC BY 4.0 and IS committed.
# QuLore (arXiv:2511.22416) is CC BY-NC-ND 4.0 -- NonCommercial and
# NoDerivatives -- so it must not be shipped here. See docs/references.md.
references/QuLore_*.pdf

# Operator Caddy drop-ins (host-owned, see deploy/caddy.d/README)
deploy/caddy.d/*.caddy

# Operator-private working files.
#
# Deliberately a generic directory rather than a list of filenames: naming the
# files here would disclose them in a public repository, which is the thing the
# rule exists to prevent. Anything an operator must keep out of the repo --
# planning notes, host access details, commercial material -- goes in here.
#
# This is a REPOSITORY-level rule and therefore travels to every clone.
# `.git/info/exclude` does not: it is per-clone, so a fresh clone had no
# protection at all and `git add -A` would have staged such files. Verified by
# simulating a clean clone.
/private/
