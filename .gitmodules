[submodule "submodules/SeQUeNCe"]
	path = submodules/SeQUeNCe
	url = https://github.com/sequence-toolbox/SeQUeNCe.git
	branch = master
[submodule "submodules/SimQN"]
	path = submodules/SimQN
	url = https://github.com/QNLab-USTC/SimQN.git
	branch = main
[submodule "submodules/arnika"]
	path = submodules/arnika
	url = https://github.com/arnika-project/arnika.git
	branch = main
	# The pin is f4cf9ba40747f3d85936ff101133e962eb417482, the head of upstream
	# PR #51 (PQC-HPKE key agreement, wire_*.go layout, one-method key-writer
	# port), dated 2026-09-24. That PR is OPEN and NOT merged, so the pin is not
	# on `main` even though `branch = main` stays for the day it is. Do not run
	# `git submodule update --remote` on this entry: it would move the pin to
	# main's head and silently drop the PQC-HPKE reader the IPsec and WireGuard
	# lanes depend on. Re-pin to the merge commit once #51 merges.
[submodule "submodules/liboqs"]
	path = submodules/liboqs
	url = https://github.com/open-quantum-safe/liboqs.git
	branch = main
[submodule "submodules/openQKDsecurity"]
	path = submodules/openQKDsecurity
	url = https://github.com/Optical-Quantum-Communication-Theory/openQKDsecurity.git
	branch = main
[submodule "submodules/oqs-provider"]
	path = submodules/oqs-provider
	url = https://github.com/open-quantum-safe/oqs-provider.git
	branch = main
[submodule "submodules/qkd-pqc-paper-supplementary"]
	path = submodules/qkd-pqc-paper-supplementary
	url = https://github.com/aparcar/qkd-pqc-paper-supplementary-files.git
	branch = main
[submodule "submodules/qkd_kme_server"]
	path = submodules/qkd_kme_server
	url = https://github.com/thomasarmel/qkd_kme_server.git
	branch = master
[submodule "submodules/qkdnetsim"]
	path = submodules/qkdnetsim
	url = https://github.com/QKDNetSim/qkdnetsim.git
	branch = master
[submodule "submodules/strawberryfields"]
	path = submodules/strawberryfields
	url = https://github.com/XanaduAI/strawberryfields.git
	branch = master
[submodule "submodules/strongswan"]
	path = submodules/strongswan
	url = https://github.com/strongswan/strongswan.git
	branch = master
[submodule "submodules/wgephemeralpeer"]
	path = submodules/wgephemeralpeer
	url = https://github.com/mullvad/wgephemeralpeer.git
	branch = master
[submodule "submodules/rosenpass"]
	path = submodules/rosenpass
	url = https://github.com/rosenpass/rosenpass.git
[submodule "submodules/tno-qkd-key-rate"]
	path = submodules/tno-qkd-key-rate
	url = https://github.com/TNO-Quantum/communication.qkd_key_rate
	# `pip install -e` on this submodule leaves an egg-info directory and several
	# __pycache__ trees in its working copy, so the PARENT reported
	# ` M submodules/tno-qkd-key-rate` permanently. No tracked file is modified
	# and the pin is unaffected -- it is build output. Ignoring untracked files
	# keeps `git status` meaningful; a status that is always dirty is one nobody
	# reads. Tracked-file modifications and pin changes still show.
	ignore = untracked
